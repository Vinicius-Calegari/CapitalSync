# Set default behavior for all files
* text=auto

# Ensure consistent line endings
*.cs text eol=lf
*.json text eol=lf
*.config text eol=lf
*.http text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.exe binary
*.pdb binary