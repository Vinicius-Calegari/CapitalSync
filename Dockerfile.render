# Render free deployment for CapitalSync (.NET 10).
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY CarteiraFinanceira.Api/CarteiraFinanceira.Api.csproj CarteiraFinanceira.Api/
RUN dotnet restore CarteiraFinanceira.Api/CarteiraFinanceira.Api.csproj
COPY CarteiraFinanceira.Api/ CarteiraFinanceira.Api/
RUN dotnet publish CarteiraFinanceira.Api/CarteiraFinanceira.Api.csproj -c Release -o /app/publish --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://0.0.0.0:10000
ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 10000
ENTRYPOINT ["dotnet", "CarteiraFinanceira.Api.dll"]
